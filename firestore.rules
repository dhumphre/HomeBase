rules_version = '2';
// Trailhead Almanac keeps each account's places on its own /users/{uid} document.
// Home Base keeps one household logbook in the subcollections of the owner's /users/{uid};
// only Google accounts listed in /access/{email} (owner: that uid) may read or write it.
// The access list is written with the admin tool (tools/hb.mjs share/invite <email>) or the household MCP tool.
// The one write the site makes: an invited account claims its invite, turning { invite: true } into { owner: its own uid },
// which gives it a separate, empty logbook under its own /users/{uid}. It can't point itself at anyone else's data.
service cloud.firestore {
  match /databases/{database}/documents {
    function household(uid) {
      return request.auth != null && request.auth.token.email != null
        && get(/databases/$(database)/documents/access/$(request.auth.token.email.lower())).data.owner == uid;
    }
    match /access/{email} {
      allow read: if request.auth != null && request.auth.token.email != null && request.auth.token.email.lower() == email;
      allow update: if request.auth != null && request.auth.token.email != null && request.auth.token.email.lower() == email
        && resource.data.get('invite', false) == true && !('owner' in resource.data)
        && request.resource.data.get('owner', '') == request.auth.uid && !('invite' in request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['owner', 'invite']);
      allow create, delete: if false;
    }
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /{document=**} {
        allow read, write: if household(uid);
      }
    }
  }
}
